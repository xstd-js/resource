  },
  "devDependencies": {
    "@types/add": "^2",
    "@types/node": "^24.10.0",
    "@vitest/coverage-istanbul": "^4.0.8",
    "msw": "^2.12.1",
    "prettier": "^3.6.2",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typedoc": "^0.28.14",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  },
  "packageManager": "yarn@4.10.3",
  "fabrique": {
    "version": "1.0.14",
