  subscribe(
    topic: string,
    listener: MqttResourceSubscribeListener,
    {
      qos = 0,
      noLocal = false,
      retainAsPublished = false,
      retainHandling = 0,
      signal,
    }: MqttResourceSubscribeOptions = {},
  ): Promise<void> {
    return this.#manager.runTask(
      async (taskSignal: AbortSignal): Promise<void> => {
        let subscription: ActiveSubscription | undefined = this.#subscriptions.get(topic);

        if (subscription !== undefined && subscription.closePromise !== undefined) {
          await abortify(subscription.closePromise, { signal: taskSignal });
          subscription = undefined;
        }

        if (subscription === undefined) {
          const controller: AbortController = new AbortController();

          subscription = {
            topic: new MqttTopic(topic),
            qos,
            noLocal,
            retainAsPublished,
            retainHandling,
            consumers: 1,
            openController: controller,
            openPromise: subscribeToMqttClientSubscription(this.#client, topic, {
              qos,
              noLocal,
              retainAsPublished,
              retainHandling,
              signal: controller.signal,
            }),
            closePromise: undefined,
          };

          this.#subscriptions.set(topic, subscription);

          // subscription = {
          //   qos,
          //   noLocal,
          //   retainAsPublished,
          //   retainHandling,
          //   consumers: 1,
