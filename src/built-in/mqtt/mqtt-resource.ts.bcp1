          //         this.#activeSubscriptions.delete(topic);
          //       });
          //
          //       manager.addTeardown((): Promise<any> => {
          //         return this.#client.unsubscribeAsync(topic);
          //       });
          //
          //       const topicMatcher: MqttTopic = new MqttTopic(topic);
          //
          //       const onClientMessage = (
          //         topic: string,
          //         payload: Buffer,
          //         _packet: IPublishPacket,
          //       ): void => {
          //         if (topicMatcher.matches(topic)) {
          //           dispatch({
          //             topic,
          //             payload,
          //           });
          //         }
          //       };
          //
          //       this.#client.on('message', onClientMessage);
          //
          //       emitter.closeSignal.addEventListener(
          //         'abort',
          //         (): void => {
          //           this.#client.off('message', onClientMessage);
          //         },
          //         { once: true },
          //       );
          //     } catch (error: unknown) {
          //       this.#activeSubscriptions.delete(topic);
          //       throw error;
          //     }
          //   })(),
          //   controller,
          // };
        } else if (
          subscription.qos !== qos ||
          subscription.noLocal !== noLocal ||
          subscription.retainAsPublished !== retainAsPublished ||
          subscription.retainHandling !== retainHandling
        ) {
          throw new Error(`Subscription to "${topic}" already locked.`);
        } else {
          subscription.consumers++;
        }

        const listenerSignal: AbortSignal = mergeAbortSignals([this.closeSignal, signal]);

        listenerSignal.addEventListener('abort', (): void => {
          subscription!.consumers--;

          if (subscription!.consumers === 0) {
            subscription!.openController.abort();
            subscription!.closePromise = this.#client
              .unsubscribeAsync(topic)
              .catch((): void => {})
              .finally((): void => {
                this.#subscriptions.delete(topic);
              });
          }
        });

        await abortify(subscription!.openPromise, { signal: taskSignal });

        const onClientMessage = (topic: string, payload: Buffer, _packet: IPublishPacket): void => {
          if (topicMatcher.matches(topic)) {
            dispatch({
              topic,
              payload,
            });
          }
        };

        this.#client.on('message', onClientMessage);

        emitter.closeSignal.addEventListener(
          'abort',
          (): void => {
            this.#client.off('message', onClientMessage);
          },
          { once: true },
        );
      },
      { signal },
    );
  }

