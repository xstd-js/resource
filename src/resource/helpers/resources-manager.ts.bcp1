import { type Abortable } from '@xstd/abortable';
import { type Resource } from '../resource.js';
import { runConcurrentlyVoidPromises } from './run-concurrently-void-promises.js';

/**
 * @deprecated
 */
export class ResourcesManager {
  readonly #resources: Set<Resource>;

  constructor() {
    this.#resources = new Set<Resource>();
  }

  add<GResource extends Resource>(resource: GResource, { signal }: Abortable = {}): GResource {
    if (!signal?.aborted) {
      if (this.#resources.has(resource)) {
        throw new Error('Resource already added.');
      }

      this.#resources.add(resource);

      const end = (): void => {
        signal?.removeEventListener('abort', end);
        this.#resources.delete(resource);
      };

      resource.closed.then(end);

      signal?.addEventListener('abort', end);
    }

    return resource;
  }

  async untilAllClosed(): Promise<void> {
    return runConcurrentlyVoidPromises(
      this.#resources.values().map((resource: Resource): Promise<void> => {
        return resource.closed;
      }),
    );
  }
}
