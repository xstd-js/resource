import { Abortable, abortify } from '@xstd/abortable';

export interface CloseResource {
  (reason: unknown): PromiseLike<void> | void;
}

export interface ResourceTask<GReturn> {
  (): GReturn;
}

export interface ResourceAsyncTask<GReturn> {
  (signal: AbortSignal): PromiseLike<GReturn> | GReturn;
}

export type ResourceState = 'open' | 'closing' | 'closed';

export class Resource extends EventTarget implements AsyncDisposable {
  readonly #close: CloseResource;
  #state: ResourceState;
  #closeReason: unknown;
  #closePromise: Promise<void> | undefined;

  // #controller: AbortController | undefined;

  readonly #pendingTasks: Map<ResourceAsyncTask<any>, Promise<any>>;

  constructor(close: CloseResource) {
    super();
    this.#close = close;
    this.#state = 'open';

    this.#pendingTasks = new Map<ResourceAsyncTask<any>, Promise<any>>();
  }

  /* CLOSE */

  get signal(): AbortSignal {
    if (this.#controller === undefined) {
      this.#controller = new AbortController();

      if (this.#closed) {
        this.#controller.abort(this.#closeReason);
      }
    }
    return this.#controller.signal;
  }

  get state(): ResourceState {
    return this.#state;
  }

  get closed(): boolean {
    return this.#state !== 'open';
  }

  get closeReason(): unknown {
    return this.#closeReason;
  }

  throwIfClosed(direct: boolean = false): void {
    if (this.#state !== 'open') {
      throw direct ?
          this.#closeReason
        : new Error('Resource closed.', {
            cause: this.#closeReason,
          });
    }
  }

  untilClosed(options?: Abortable): Promise<unknown> {
    return abortify<unknown>(this.#untilClosed.promise, options);
  }

  close(reason?: unknown): Promise<void> {
    if (this.#state === 'open') {
      this.#state = 'closing';
      this.#closeReason = reason;
      this.dispatchEvent(new Event('closing'));

      this.#closePromise = Promise.allSettled(this.#pendingTasks)
        .then((): PromiseLike<void> | void => {
          return this.#close(reason);
        })
        .finally((): void => {
          this.#state = 'closed';
          this.dispatchEvent(new Event('closed'));
        });
    }

    return this.#closePromise!;
  }

  [Symbol.asyncDispose](): Promise<void> {
    return this.close();
  }

  /* RUN TASKS */

  task<GReturn>(task: ResourceTask<GReturn>): GReturn {
    this.throwIfClosed();
    return task();
  }

  async asyncTask<GReturn>(task: ResourceAsyncTask<GReturn>): Promise<GReturn> {
    this.throwIfClosed();

    if (this.#pendingTasks.has(task)) {
      throw new Error('Task already running.');
    }

    const promise: Promise<GReturn> = Promise.try((): PromiseLike<GReturn> | GReturn => {
      return task(this.signal);
    }).finally((): void => {
      this.#pendingTasks.delete(task);
    });

    this.#pendingTasks.set(task, promise);

    return promise;
  }

  /* FORK */

  fork<GResource extends Resource>(resource: GResource): GResource {
    // this.signal.addEventListener(() => {
    //   return this.untilClosed().then(() => {
    //
    //   });
    // });

    this.signal.addEventListener(
      'abort',
      (): void => {
        void this.close(this.signal.reason);
      },
      {
        signal: this.signal,
      },
    );

    this.signal.addEventListener(() => {
      return this.untilClosed().then(() => {});
    });
  }

  childOf(resource: Resource): this {
    resource.signal.addEventListener(
      'abort',
      (): void => {
        void this.close(resource.signal.reason);
      },
      {
        signal: this.signal,
      },
    );
    return this;
  }
}
