import { noop } from '@xstd/noop';
import { type CloseResource, Resource } from '../../resource/resource.js';

export interface EmitterResourceListener<GValue> {
  (value: GValue): void;
}

export interface EmitterResourceInitFunction<GValue> {
  (dispatch: EmitterResourceDispatchFunction<GValue>): CloseResource;
}

export interface EmitterResourceDispatchFunction<GValue> {
  (value: GValue): void;
}

export class EmitterResource<GValue> extends Resource {
  static readonly #maxUnsubscribeCount: number = 0xff;

  // the list of listeners
  #listeners: EmitterResourceListener<GValue>[];

  // the number of postponed unsubscribed listeners
  #postponedUnsubscriptions: number;
  // the id of the last batch of unsubscriptions
  #lastUnsubscriptionsBatchId: number;
  // if we are dispatching
  #dispatching: boolean;

  constructor(init: EmitterResourceInitFunction<GValue>) {
    super(
      init((value: GValue): void => {
        this.#dispatch(value);
      }),
    );
    this.#listeners = [];
    this.#postponedUnsubscriptions = 0;
    this.#lastUnsubscriptionsBatchId = 0;
    this.#dispatching = false;
  }

  #dispatch(value: GValue): void {
    this.throwIfClosed();

    if (this.#dispatching) {
      throw new Error('Dispatch loop detected.');
    }

    this.#dispatching = true;

    for (let i: number = 0; i < this.#listeners.length; i++) {
      this.#listeners[i](value);
    }

    this.#batchUnsubscribe();

    this.#dispatching = false;
  }

  #batchUnsubscribe(): void {
    if (this.#postponedUnsubscriptions >= EmitterResource.#maxUnsubscribeCount) {
      this.#postponedUnsubscriptions = 0;
      this.#lastUnsubscriptionsBatchId++;
      this.#listeners = this.#listeners.filter(
        (listener: EmitterResourceListener<GValue>): boolean => {
          return listener !== noop;
        },
      );
    }
  }

  listen(listener: EmitterResourceListener<GValue>): Resource {
    this.throwIfClosed();

    let listenerIndex: number = this.#listeners.length;
    let listenerUnsubscriptionsBatchId: number = this.#lastUnsubscriptionsBatchId;

    this.#listeners.push(listener);

    return new Resource((): void => {
      if (listenerUnsubscriptionsBatchId !== this.#lastUnsubscriptionsBatchId) {
        // => a batch of unsubscriptions happened before we unsubscribed this listener
        listenerIndex = this.#listeners.indexOf(listener);
      }
      this.#listeners[listenerIndex] = noop;

      if (!this.#dispatching) {
        this.#batchUnsubscribe();
      }
    }).childOf(this);
  }
}
