/*---*/

async function example01() {
  await using file: any = await fs('/path/to/file', 'r').open();

  await file.write('abc');
}

async function example02() {
  await using ws: any = await websocket('wss://test.com').open();

  await ws.send('abc');

  for await (const message of ws.receiver /* non closable resource */) {
  }
}

async function example03() {
  await using mqtt: any = await openMqtt('mqtt://test.com');

  await mqtt.publish('abc');

  await using subscription: any = await mqtt.subscribe('topic'); // <= closable resource

  for await (const message of subscription) {
  }
}

async function example04() {
  await using mqtt: any = await openMqtt('mqtt://test.com');

  await mqtt.publish('abc');

  await using subscription: any = await mqtt.subscribe('topic'); // <= closable resource

  const packets = subscription.map((message: any) => message.payload); // <= non closable resource

  for await (const message of packets) {
  }
}

async function example05() {
  await using mqtt: any = await openMqtt('mqtt://test.com'); // <= closable resource

  await mqtt.publish('abc');

  const subscriber: any = mqtt.subscriber('topic'); // <= resource factory

  const packets = subscriber.map((message: any) => message.payload); // <= resource factory

  await using subscription: any = await packets.open(); // <= closable resource

  for await (const message of subscription) {
  }
}

