/*---*/

export interface CloseResource {
  (reason: unknown): PromiseLike<void> | void;
}

export interface ResourceTask<GReturn> {
  (): PromiseLike<GReturn> | GReturn;
}

export interface ResourceEventMap {
  close: Event;
}

export class Resource extends EventTarget implements AsyncDisposable {
  readonly #close: CloseResource;
  readonly #pendingTasks: Set<ResourceTask<any>>;
  #closePromise: Promise<void> | undefined;
  #closeReason: unknown;

  constructor(close: CloseResource) {
    super();
    this.#close = close;
    this.#pendingTasks = new Set<ResourceTask<any>>();
  }

  async task<GReturn>(task: ResourceTask<GReturn>): Promise<GReturn> {
    if (this.#pendingTasks.has(task)) {
      throw new Error('Task already running.');
    }

    this.#pendingTasks.add(task);

    try {
      return await task();
    } finally {
      this.#pendingTasks.delete(task);
    }
  }

  get closed(): boolean {
    return this.#closePromise !== undefined;
  }

  get closeReason(): unknown {
    return this.#closeReason;
  }

  throwIfClosed(): void {
    if (this.closed) {
      throw this.#closeReason;
    }
  }

  close(reason?: unknown): Promise<void> {
    if (this.#closePromise === undefined) {
      this.#closeReason = reason;
      this.#closePromise = Promise.allSettled(this.#pendingTasks)
        .then((): PromiseLike<void> | void => {
          return this.#close(reason);
        })
        .finally((): void => {
          this.dispatchEvent(new Event('close'));
        });
    }

    return this.#closePromise;
  }

  [Symbol.asyncDispose](): Promise<void> {
    return this.close();
  }

  override addEventListener<K extends keyof ResourceEventMap>(
    type: K,
    listener: (event: ResourceEventMap[K]) => any,
    options?: boolean | AddEventListenerOptions,
  ): void;
  override addEventListener(
    type: string,
    listener: EventListenerOrEventListenerObject,
    options?: boolean | AddEventListenerOptions,
  ): void;
  override addEventListener(
    type: string,
    listener: EventListenerOrEventListenerObject,
    options?: boolean | AddEventListenerOptions,
  ): void {
    return super.addEventListener(type, listener, options);
  }

  override removeEventListener<K extends keyof ResourceEventMap>(
    type: K,
    listener: (event: ResourceEventMap[K]) => any,
    options?: boolean | EventListenerOptions,
  ): void;
  override removeEventListener(
    type: string,
    listener: EventListenerOrEventListenerObject,
    options?: boolean | EventListenerOptions,
  ): void;
  override removeEventListener(
    type: string,
    listener: EventListenerOrEventListenerObject,
    options?: boolean | EventListenerOptions,
  ): void {
    return super.removeEventListener(type, listener, options);
  }
}

/*---*/

export type TasmotaPowerState = 'ON' | 'OFF';
export type SetTasmotaPower = TasmotaPowerState | 'TOGGLE';

export interface TasmotaPowerResource extends Resource {
  set(value: SetTasmotaPower, options?: Abortable): Promise<void>;

  get(options?: Abortable): Promise<TasmotaPowerState>;

  readonly change$: EventEmitter<TasmotaPowerState>;
}

/*---*/

export interface ZigbeeResource extends Resource {
  send(packet: ZigbeePacket, options?: Abortable): Promise<void>;

  readonly receive$: EventEmitter<ZigbeePacket>;
}

/*---*/

export interface MqttResource extends Resource {
  publish(topic: string, payload: string | Uint8Array, options?: Abortable): Promise<void>;

  subscribe(topic: string, options?: Abortable): Promise<MqttSubscriptionResource>;
}

export interface MqttSubscriptionResource extends Resource {
  readonly packet$: EventEmiter<any>;
}

/*---*/

export interface ThingProperty<GValue> extends Resource {
  set(value: GValue, options?: Abortable): Promise<void>;

  get(options?: Abortable): Promise<GValue>;

  readonly change$: EventEmiter<GValue>;
}
